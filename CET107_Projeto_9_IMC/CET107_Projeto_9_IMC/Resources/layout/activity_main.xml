<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
	android:fitsSystemWindows="true"
	android:gravity="top"
	android:orientation="vertical"
	android:background="@drawable/bg_completo"
	android:backgroundTint="#44FFFFFF"
	android:backgroundTintMode="multiply"		  
>
	<!-- Cartao peso -->
	<LinearLayout
		android:id="@+id/cardPeso"
		android:background="@drawable/backgdefault"
		android:orientation="vertical"	
		android:elevation="6dp"
		android:padding="10dp"
		android:gravity="center"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="10dp"
		android:layout_marginBottom="0dp"
		android:layout_marginLeft="10dp"
		android:layout_marginRight="10dp"
		>

		<EditText
			android:id="@+id/etPeso"
			android:hint="Peso (Kg)"
			android:textSize="25sp"
			android:inputType="numberDecimal"
			android:textColorHint="#AAA"
			android:textColor="#A68ACB"
			android:background="@android:color/transparent"
			android:gravity="center"
			android:padding="5dp"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="0dp"
			android:layout_marginBottom="0dp"
			android:layout_marginLeft="0dp"
			android:layout_marginRight="0dp"
			/>
	</LinearLayout>

	<!--  Cartao altura -->
	<LinearLayout
		android:id="@+id/cardAltura"
		android:background="@drawable/backgdefault"
		android:orientation="vertical"
		android:elevation="6dp"
		android:padding="10dp"
		android:gravity="center"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="10dp"
		android:layout_marginBottom="0dp"
		android:layout_marginLeft="10dp"
		android:layout_marginRight="10dp"
		>

		<EditText
			android:id="@+id/etAltura"
			android:hint="Altura (cm)"
			android:textSize="25sp"
			android:inputType="numberDecimal"
			android:textColorHint="#AAA"
			android:textColor="#A68ACB"
			android:background="@android:color/transparent"
			android:gravity="center"
			android:padding="5dp"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="0dp"
			android:layout_marginBottom="0dp"
			android:layout_marginLeft="0dp"
			android:layout_marginRight="0dp"
			/>
	</LinearLayout>

	<!--  Cartao botao calcular -->
	<LinearLayout
		android:id="@+id/cardCalcular"
		android:background="@drawable/backginvert"
		android:orientation="vertical"
		android:elevation="6dp"
		android:padding="10dp"
		android:gravity="center"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="10dp"
		android:layout_marginBottom="0dp"
		android:layout_marginLeft="10dp"
		android:layout_marginRight="10dp"
		>

		<Button
			android:id="@+id/btCalcular"
			android:text="Calcular"
			android:textSize="25sp"
			android:textColor="#FFF"
			android:background="@android:color/transparent"
			android:gravity="center"
			android:padding="5dp"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="0dp"
			android:layout_marginBottom="0dp"
			android:layout_marginLeft="0dp"
			android:layout_marginRight="0dp"
			/>

	</LinearLayout>


	<!--  Cartao textView imc-->
	<LinearLayout
		android:id="@+id/cardIMC"
		android:background="@drawable/backgdefault"
		android:orientation="vertical"
		android:elevation="6dp"
		android:padding="10dp"
		android:gravity="center"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="10dp"
		android:layout_marginBottom="0dp"
		android:layout_marginLeft="10dp"
		android:layout_marginRight="10dp"
		>

		<TextView
			android:id="@+id/tvIMC"
			android:hint="IMC (Kg/m^2)"
			android:textSize="25sp"
			android:textColor="#A68ACB"
			android:background="@android:color/transparent"
			android:gravity="center"
			android:padding="5dp"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="0dp"
			android:layout_marginBottom="0dp"
			android:layout_marginLeft="0dp"
			android:layout_marginRight="0dp"
			/>

	</LinearLayout>

</LinearLayout>