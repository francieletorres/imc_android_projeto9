<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
	android:fitsSystemWindows="true"
	android:gravity="top"
	android:orientation="vertical"
	android:background="@drawable/bg_completo"
	android:backgroundTint="#44FFFFFF"
	android:backgroundTintMode="multiply"		  
>

	<!-- Barra de ferramentas -->
	<android.widget.Toolbar 
		android:id="@+id/toolbar"
		android:background="@color/colorPrimary"
		android:padding="0dp"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginBottom="0dp">
	

		<LinearLayout
			android:layout_width="match_parent"
			android:padding="0dp"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center"
			android:layout_margin="0dp">

			<ImageView
				android:id="@+id/ivLogo"
				android:layout_width="0dp"
				android:layout_weight="1"
				android:layout_height="35dp"
				android:src="@drawable/icon_bmi01"
				android:contentDescription="Logo da App"
				android:scaleType="fitCenter"
				android:layout_marginLeft="0dp"
				android:layout_marginRight="0dp"/>

			<TextView
				android:id="@+id/tvTitulo"
				android:text="@string/app_name2"
				android:textSize="20sp"
				android:textColor="@color/btTextColor"
				android:gravity="center"
				android:padding="0dp"
				android:layout_width="0dp"
				android:layout_weight="8"
				android:layout_height="wrap_content"
				android:layout_marginLeft="0dp"
				android:layout_marginRight="0dp"/>

			<ImageButton
				android:id="@+id/imSair"
				android:src="@drawable/icon_exit01"
				android:contentDescription="Saída"
				android:background="?android:attr/selectableItemBackgroundBorderless"
				android:padding="0dp"
				android:layout_width="0dp"
				android:layout_weight="1"
				android:layout_height="35dp"
				android:scaleType="centerInside"
				android:layout_marginLeft="0dp"
				android:layout_marginRight="15dp"
				/>

		</LinearLayout>

	</android.widget.Toolbar>


	<!-- Cartao peso -->
	<LinearLayout
		android:id="@+id/cardPeso"
		android:background="@drawable/bg_backgdefault"
		style="@style/CardStyle"
		>

		<EditText
			android:id="@+id/etPeso"
			android:hint="@string/sPeso"
			style="@style/etCommonProperties"
			/>

	</LinearLayout>


	<!--  Cartao altura -->
	<LinearLayout
		android:id="@+id/cardAltura"
		android:background="@drawable/bg_backgdefault"
		style="@style/CardStyle"
		>

		<EditText
			android:id="@+id/etAltura"
			android:hint="@string/sAltura"
			style="@style/etCommonProperties"
			/>

	</LinearLayout>


	<!--  Cartao botao calcular -->
	<LinearLayout
		android:id="@+id/cardCalcular"
		android:background="@drawable/bg_backginvert"
		style="@style/CardStyle"
		>

		<Button
			android:id="@+id/btCalcular"
			android:text="@string/sCalcular"
			style="@style/btCommonProperties"
			/>

	</LinearLayout>


	<!--  Cartao botao Limpar -->
	<LinearLayout
		android:id="@+id/cardLimpar"
		android:background="@drawable/bg_backginvert"
		style="@style/CardStyle"
		>

		<Button
			android:id="@+id/btLimpar"
			android:text="@string/sLimpar"
			style="@style/btCommonProperties"
			/>

	</LinearLayout>


	<!--  Cartao textView imc-->
	<LinearLayout
		android:id="@+id/cardIMC"
		android:background="@drawable/bg_backgdefault"
		style="@style/CardStyle"
		>

		<TextView
			android:id="@+id/tvIMC"
			android:hint="@string/sIMC"
			style="@style/tvCommonProperties"
			/>

	</LinearLayout>

</LinearLayout>